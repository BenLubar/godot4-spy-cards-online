	<constants>
		<constant name="SHARED_SEED_LENGTH" value="32">
		</constant>
		<constant name="INIT_WAIT" value="0" enum="MatchState">
			Waiting for Authority (player 1) to send game static data and initial random seed.
		</constant>
		<constant name="ABORTED" value="1" enum="MatchState">
			One or more players encountered a fatal error.
		</constant>
		<constant name="COSMETIC" value="2" enum="MatchState">
			Selecting player character and display name.
		</constant>
		<constant name="DECK" value="3" enum="MatchState">
			Selecting cards for deck.
		</constant>
		<constant name="START_WAIT" value="4" enum="MatchState">
			Player character, display name, and deck selected. Waiting for other players to begin.
		</constant>
		<constant name="RESOLVE" value="5" enum="MatchState">
			Match is processing Jigsaw commands autonomously - waiting for the game mode to request user input.
		</constant>
		<constant name="CHOICE" value="6" enum="MatchState">
			Players are being prompted to select cards - waiting for all players to confirm their choices.
		</constant>
		<constant name="REALTIME" value="7" enum="MatchState">
			Game mode is running using rollback netcode and live inputs.
		</constant>
		<constant name="REALTIME_WAIT" value="8" enum="MatchState">
			Consensus state has reached the end of the REALTIME command - waiting for all players to synchronize.
		</constant>
		<constant name="FINALIZE" value="9" enum="MatchState">
			Match is over - waiting for final confirmation.
		</constant>
		<constant name="COMPLETED" value="10" enum="MatchState">
			Match is over and confirmed - player being prompted to request a rematch.
		</constant>
		<constant name="REMATCH_WAIT" value="11" enum="MatchState">
			Match is over and confirmed - player is requesting a rematch.
		</constant>
		<constant name="REMATCH_ABORTED" value="12" enum="MatchState">
			Match is over and confirmed - one or more players has left.
		</constant>
	</constants>
